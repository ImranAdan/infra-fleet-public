# Flask Application Configuration
# Copy this file to .env and modify as needed

PORT=8080
FLASK_ENV=development
FLASK_DEBUG=1
ENVIRONMENT=local
APP_VERSION=dev

# API Key Authentication (optional)
# If set, all endpoints except /health and /ready require X-API-Key header.
# If not set, authentication is disabled (dev mode).
# API_KEY=your-secret-api-key-here

# Chaos/Fault Injection (optional)
# Float between 0.0 and 1.0 - probability of random 500 errors.
# 0.0 = disabled (default), 0.3 = 30% failure rate.
# Does NOT affect /health or /ready endpoints (K8s probes always work).
FAIL_RATE=0.0

# Optional: Observability Stack
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Flask session signing key (optional locally)
# If unset, a random key is generated at startup. That is fine for local
# development, but it means sessions do not survive a restart.
#
# In Kubernetes this is supplied by the `load-harness-secret-key` Secret,
# which rebuild-stack.yml generates - it must be identical across replicas or
# dashboard logins break as requests land on different pods.
# SECRET_KEY=

# Prometheus base URL (optional)
# Auto-detected: the `prometheus` service locally, kube-prometheus-stack in
# Kubernetes. Set this only to point at something else.
# PROMETHEUS_URL=
