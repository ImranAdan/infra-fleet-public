# Copy this file to config.env and replace every value marked CHANGE_ME.
# This file contains identifiers only. Keep credentials in your shell, HCP
# Terraform, and GitHub Actions secrets as described in CONFIGURATION.md.

GITHUB_REPOSITORY=CHANGE_ME_OWNER/CHANGE_ME_REPOSITORY
GITHUB_DEPLOYMENT_BRANCH=main
GITHUB_DEPLOYMENT_ENVIRONMENT=staging

TF_CLOUD_ORGANIZATION=CHANGE_ME_HCP_ORGANIZATION
TF_WORKSPACE_PERMANENT=infra-fleet-permanent
TF_WORKSPACE_STAGING=infra-fleet-staging

# JSON array of IAM role or user ARNs. Prefer an identity-centre role to a user.
# Set the same value as the HCP Terraform variable eks_admin_principal_arns.
EKS_ADMIN_PRINCIPAL_ARNS_JSON='[]'
